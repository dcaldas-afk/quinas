Package  quinas;

Helpers
    digito = ['0' .. '9'];
    minuscula = ['a' .. 'z'];
    maiuscula = ['A' .. 'Z'];
    letra = maiuscula | minuscula;
    espaco = ' ';
    tab = 9;
    rc = 13;
    nl = 10;
    invalidos = '@' | '_' | '$' | '´' | '+' | '-' | '^' | '%' | '`' | 'ç';

Tokens
    numeral_int = digito+;

    id_const = maiuscula maiuscula+;
    id_funcao = maiuscula letra+;
    id = letra letra+;
	
    soma = '+';
    menos = '-';
    mult = '.';
    div = '/';
    resto = '\';
    div_int = '//';
    potencia = '´';
    
    decimal = digito+ ',' digito+;
    inteiro = ('+' | '-')? digito+;
    binario = '0b'('0' | '1')+;
	booleano = ('V' | 'F');
	
    maior = '>>';
    menor = '<<';
    igual = '==';

    col_esq = '[';
    col_dir = ']';
    par_esq = '<';
    par_dir = '>';
    
    and = '^';
    not = '¬';
    or = 'v';
    
    marcador = '++';
    guarda = '||';
    sustenido = '#';
    pipe = '|';
    igual_simples = '=';
    
    vazio = (espaco | tab | rc | nl | invalidos)+;

Ignored Tokens
    vazio;