Package quinas;

Helpers
 digito = ['0' .. '9'];
 espaco = ' ';
 rc = 13;
 nl = 10;
 maius = ['A' .. 'Z'];
 minus = ['a' .. 'z'];
 letra = maius | minus;
 
Tokens
 numero = digito+;
 id = letra letra+;
 id_funcao = maius letra+
 id_const = maius maius+
 soma = '+';
 menos = '-';
 mult = '.';
 div_real = '/';
 mod = '\';
 div_int = '//';
 igual = '==';
 and = '^';
 not = '¬';
 or = 'v';
 par_esq = '<';
 par_dir = '>';
 vazio = (espaco | rc | nl)+;


Ignored Tokens
 vazio;