Package  quinas;

Helpers
    any = [0 .. 0xffff];
    espaco = ' ';
    tab = 9;
    rc = 13;
    nl = 10;
    no_break = [any - [nl + rc]];
    nao_menos = [any - '-'];
    nao_menos_barra = [nao_menos - '/'];
    digito = ['0' .. '9'];
    minuscula = ['a' .. 'z'];
    maiuscula = ['A' .. 'Z'];
    letra = maiuscula | minuscula;

Tokens
    numeral_int = digito+ | '0b'('0' | '1')+;
    numeral_real = digito+ ',' digito+;
    tipo_numero = 'numero';
    tipo_booleano = 'booleano';
    literal_booleano = 'V' | 'F';

    id_const = maiuscula maiuscula+;
    id_funcao = maiuscula letra+;
    id = minuscula minuscula+;

    soma = '+';
    menos = '-';
    mult = '.';
    div = '/';
    resto = '\';
    div_int = '//';
    potencia = '´';

    maior = '>>';
    menor = '<<';
    igual = '==';
    igual_simples = '=';

    col_esq = '[';
    col_dir = ']';
    par_esq = '<';
    par_dir = '>';
    
    and = '^';
    not = '¬';
    or = 'v';

    guarda = '||';
    pipe = '|';
    dois_pts = ':';
    declar_funct = '++';
    sustenido = '#';
    comentario_linha = '--' no_break*;
    comentario_bloco = '/--' (nao_menos | '-' nao_menos | '--' '-'* nao_menos_barra)* '-'* '--/';
    
    vazio = (espaco | tab | rc | nl)+;

Ignored Tokens
    vazio,
    comentario_linha,
    comentario_bloco;

Productions
    programa =
        dec_funcao+;

    dec_funcao =
        declar_funct?
        [ini_funcao]:col_esq
        tipo id_funcao
        [ini_lst_param]:col_esq 
        lista_parametros?
        [fim_lst_param]:col_dir
        dois_pts
        [ini_exp]:col_esq
        exp
        [fim_exp]:col_dir
        [fim_funcao]:col_dir;
    
    tipo =
        {numero} tipo_numero | {booleano} tipo_booleano;

    lista_parametros =
        {param_unico} parametro | {multi_param} lista_parametros pipe parametro;

    parametro =
        {tipo_id} tipo id | {assinatura} assinatura;
    
    assinatura =
        tipo id_funcao col_esq parametros_assinatura? col_dir;
    
    parametros_assinatura =
        {assinatura_unica} parametro_assinatura | {multi_assinatura} parametros_assinatura pipe parametro_assinatura;

    parametro_assinatura =
        {tipo} tipo | {assinatura} assinatura;
    
    bloco_exp =
        col_esq dec_cons+ exp col_dir;
    
    dec_cons =
        [ini_const]:col_esq
        tipo
        id_const
        [ini_exp]:col_esq
        exp
        [fim_exp]:col_dir
        [fim_const]:col_dir;
    
    chamada =
        id_funcao col_esq lista_args? col_dir;
    
    lista_args =
        {arg_unico} arg | {multi_arg} lista_args pipe arg;
    
    arg =
        {arg_comum} exp | {funcao_como_arg} id_funcao;
    
    guarda =
        col_esq clausula+ T.guarda sustenido igual_simples exp col_dir;

    clausula =
        T.guarda
        [condicao]:exp
        igual_simples
        [resultado]:exp;
    
    exp =
        exp_ou;

    exp_ou =
    	{and} exp_e
    	| {or} exp_ou or exp_e;
    
    
    exp_e =
    	{igual} exp_igual
    	| {and} exp_e and exp_igual;
    	
    	
    exp_igual =
   		{relacional} exp_r
   		| {igual} exp_igual igual exp_r;
   		
   		
    exp_r =
   		{soma} exp_soma
   		| {maior} exp_r maior exp_soma
   		| {menor} exp_r menor exp_soma;
   
   
    exp_soma = 
   		{mult} exp_mult
   		| {soma} exp_soma soma exp_mult
   		| {menos} exp_soma menos exp_mult;
   
   
    exp_mult =
   		{potencia} exp_pot
   		| {mult} exp_mult mult exp_pot
   		| {div} exp_mult div exp_pot
   		| {inteira} exp_mult div_int exp_pot
   		| {resto} exp_mult resto exp_pot;
    
    
    exp_pot =
   		{unario} exp_un
   		| {potencia} exp_un potencia exp_pot;
    
    
    exp_un =
    	{termo} termo
    	| {menos_un} menos exp_un
    	| {nao_un} not exp_un;
    
    
    termo = 
    	{inteiro} numeral_int
    	| {real} numeral_real
    	| {literal} literal_booleano
    	| {id} id
    	| {idconst} id_const
    	| {bloco} bloco_exp
    	| {chamada} chamada
    	| {guarda} P.guarda
    	| {par} par_esq exp_ou par_dir;